MYSQL_DATABASE=gputrain
MYSQL_USER=gputrain
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
# SSH credential encryption only; Base64 of exactly 32 random bytes, supplied to the Java process.
# Generate outside Git (for example: openssl rand -base64 32); keep stable across restarts.
# Leaving blank disables SSH credential operations.
GPUTRAIN_SSH_MASTER_KEY=
# Qwen (DashScope OpenAI-compatible mode) API key for P4 agent proposal drafting.
# Leaving blank makes agent drafting return QWEN_API_KEY_NOT_CONFIGURED; manual proposals still work.
QWEN_KEY=
