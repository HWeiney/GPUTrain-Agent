MYSQL_DATABASE=gputrain
MYSQL_USER=gputrain
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
# Control-plane Java process only; leave these blank until configured outside Git.
# Master key must be Base64 for exactly 32 decoded bytes. Keep both values stable.
RUNNER_CREDENTIAL_MASTER_KEY=
RUNNER_ENROLLMENT_PEPPER=

# SSH inventory encryption only; Base64 of exactly 32 random bytes, supplied to the Java process.
# Generate outside Git (for example: openssl rand -base64 32); keep stable across restarts.
# Leaving blank disables SSH credential operations and preserves existing Runner operation.
GPUTRAIN_SSH_MASTER_KEY=
