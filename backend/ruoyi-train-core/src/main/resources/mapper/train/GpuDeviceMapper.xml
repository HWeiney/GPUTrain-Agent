<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.train.core.gpu.mapper.GpuDeviceMapper">
    <resultMap id="DeviceResult" type="com.ruoyi.train.core.gpu.domain.GpuDeviceRecord">
        <constructor>
            <idArg column="device_id" javaType="java.lang.Long"/>
            <arg column="gpu_uuid" javaType="java.lang.String"/>
            <arg column="host_signature" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="identity_state" javaType="java.lang.String"/>
            <arg column="schedulable" javaType="_boolean"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <insert id="upsert" parameterType="com.ruoyi.train.core.gpu.domain.GpuDeviceRecord">
        INSERT INTO train_gpu_device
            (gpu_uuid, host_signature, name, identity_state, schedulable, created_at, updated_at)
        VALUES
            (#{gpuUuid}, #{hostSignature}, #{name}, #{identityState}, #{schedulable}, #{createdAt}, #{updatedAt})
        ON DUPLICATE KEY UPDATE
            host_signature = VALUES(host_signature),
            name = VALUES(name),
            identity_state = VALUES(identity_state),
            schedulable = VALUES(schedulable),
            updated_at = VALUES(updated_at)
    </insert>

    <select id="findByUuid" resultMap="DeviceResult">
        SELECT * FROM train_gpu_device WHERE gpu_uuid = #{gpuUuid}
    </select>

    <select id="listByHost" resultMap="DeviceResult">
        SELECT * FROM train_gpu_device WHERE host_signature = #{hostSignature}
    </select>

    <update id="markAbsentUnobservable">
        UPDATE train_gpu_device
        SET identity_state = 'UNOBSERVABLE', schedulable = 0, updated_at = #{updatedAt}
        WHERE host_signature = #{hostSignature}
        <if test="visibleUuids != null and visibleUuids.size() > 0">
            AND gpu_uuid NOT IN
            <foreach collection="visibleUuids" item="uuid" open="(" separator="," close=")">#{uuid}</foreach>
        </if>
    </update>
</mapper>
